# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=3000
MONGO_URI=
ADMIN_SECRET_PASS=
ADMIN_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional now: leave empty and login from Admin Panel (phone + OTP) instead
HARDCODED_SESSION_STRING=
TARGET_BOT_USERNAME=@JPWREACHEDBOT
PRIVATE_PG_URL=
PRIVATE_API_KEY=
CUSTOMER_BOT_TOKEN=
ADMIN_BOT_TOKEN=
BOT_TOKEN=
SERVER_PUBLIC_URL=
WHATSAPP_NUMBER=
INTERNAL_API_SECRET=
# Comma-separated exact browser origins allowed to call this API cross-origin. Empty = same-origin only.
CORS_ORIGINS=https://your-domain.example
# Keep this 32-byte key stable forever; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
# Optional HMAC secret if your payment provider supports signed webhooks.
PRIVATE_WEBHOOK_SECRET=
# Optional now: set it from Admin Panel > Connections > Google Sheet instead (panel value wins over this)
GOOGLE_SHEET_SCRIPT_URL=

# --- Render anti-sleep auto-ping (optional) ---
# Render sets RENDER_EXTERNAL_URL automatically; override only if needed
KEEP_ALIVE_URL=
KEEP_ALIVE_MINUTES=5
KEEP_ALIVE=true

# --- Optional ---
# Secret used to sign user login sessions. If empty, it is derived automatically from your other secrets.
SESSION_SECRET=

# --- WhatsApp admin code: SHA-256 of the secret code (the code itself is not stored). Make a new one: node scripts/make-admin-code.js
WA_ADMIN_CODE_HASH=
# Password that locks the nightly backup file (if empty, ADMIN_SECRET_PASS is used)
BACKUP_PASSWORD=

# White-label branding defaults (Admin Panel can override unless BRANDING_ENV_LOCK=true)
SITE_NAME=JPW
SITE_TAGLINE=
SITE_LOGO_URL=
BRANDING_ENV_LOCK=false

# --- Fresh installation only (run once against a brand-new empty jpw_* database) ---
PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_NAME=Platform Owner
# Set only for the one-time initializer, then remove:
# FRESH_DB_CONFIRM=JPW_FRESH_EMPTY_DATABASE

# Central TAKNA license portal (JPW product lock)
LICENSE_API_BASE=https://license.takna.online/api/v1
LICENSE_PRODUCT_CODE=JPW
LICENSE_DOMAIN=your-production-domain.example
LICENSE_VERIFY_INTERVAL_MS=21600000
LICENSE_REQUEST_TIMEOUT_MS=10000
